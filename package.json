{
  "name": "board_dev",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:up": "docker compose -f docker/docker.compose.yml up -d postgres",
    "db:down": "docker compose -f docker/docker.compose.yml down",
    "db:logs": "docker compose -f docker/docker.compose.yml logs -f postgres",
    "db:validate": "pnpm --filter api db:validate",
    "db:generate": "pnpm --filter api db:generate",
    "db:init": "pnpm --filter api db:init",
    "db:push": "pnpm --filter api db:push",
    "db:import": "pnpm --filter api db:import",
    "db:seed": "pnpm db:import",
    "db:verify": "pnpm --filter api db:verify",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.6.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "proj4": "^2.20.2",
    "react-icons": "^5.5.0",
    "react-kakao-maps-sdk": "^1.2.0"
  }
}
